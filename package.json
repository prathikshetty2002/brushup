{
  "name": "brushup",
  "version": "0.1.3",
  "type": "module",
  "description": "A visual canvas for touching up agent-generated UI on the page itself. Edits are written back to your HTML/CSS, React and Tailwind source, and Claude Code can read your notes over MCP.",
  "scripts": {
    "brushup": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx demo/record.ts",
    "demo:claude": "tsx demo/record-claude.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:cjs && npm run check:types",
    "check:cjs": "node scripts/check-cjs-deps.mjs",
    "check:types": "node scripts/check-types.mjs",
    "e2e": "node scripts/e2e-browser.mjs",
    "e2e:dev": "node scripts/e2e-dev.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.14",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "magic-string": "^0.30.21",
    "parse5": "^7.3.0",
    "postcss": "^8.5.33",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "exports": {
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      },
      "default": "./dist/vite.js"
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      },
      "default": "./dist/next.js"
    },
    "./next/script": {
      "types": "./dist/next-script.d.ts",
      "default": "./dist/next-script.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "prathikshetty2002",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prathikshetty2002/brushup.git"
  },
  "homepage": "https://github.com/prathikshetty2002/brushup#readme",
  "bugs": {
    "url": "https://github.com/prathikshetty2002/brushup/issues"
  },
  "keywords": [
    "visual-editor",
    "ui",
    "canvas",
    "tailwind",
    "tailwindcss",
    "nextjs",
    "react",
    "vite",
    "shadcn",
    "mcp",
    "claude-code",
    "ai-agents",
    "devtools"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "brushup": "dist/cli.js",
    "brushup-mcp": "dist/mcp.js"
  },
  "peerDependencies": {
    "next": ">=15.3",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "dist/vite.d.ts"
      ],
      "next": [
        "dist/next.d.ts"
      ],
      "next/script": [
        "dist/next-script.d.ts"
      ]
    }
  }
}
